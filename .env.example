SYNC_SCHEDULE_TZ=

# --- Scheduler HTTP hardening (recommended) ---
# Hard deadline in ms for a single provider (Socrata/NY Open Data) HTTP request.
SYNC_PROVIDER_TIMEOUT_MS=30000

# Maximum automatic retries AFTER the initial attempt for transient failures
# (request timeout / network error / HTTP 408 / 429 / 500 / 502 / 503 / 504).
# Permanent errors (4xx, validation/malformed payload, config errors) are NOT retried.
SYNC_MAX_RETRIES=2

# Base delay in ms for exponential backoff between retries.
# retry n waits: baseDelayMs * 2^(n-1)  (i.e. 2000ms, then 4000ms).
SYNC_RETRY_DELAY_MS=2000

# Fail-safe deadline in ms for a single scheduled SYNC RUN (one category/date).
# A run that exceeds this deadline is marked failed, its sync_run is finalized
# with success=false, and the scheduler proceeds to the next category/date so a
# single stuck run can never block future ticks.
SYNC_TICK_TIMEOUT_MS=120000
