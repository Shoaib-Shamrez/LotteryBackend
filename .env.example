# Database configuration
DATABASE_URL=

# Server configuration
PORT=5000
BASE_URL=http://localhost:3000

# Automated Sync Secret for /api/sync/trigger
SYNC_SECRET=

# Admin session cookie HMAC secret (min 32 chars; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_SESSION_SECRET=

# Comma-separated list of allowed frontend origins for CORS with credentials
ADMIN_FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# Automated sync scheduler. The scheduler is a no-op when NODE_ENV=test.
# Cron expression (5-field standard cron). Default: 03:00 every day.
# Examples:
#   "0 3 * * *"    -> daily at 03:00
#   "*/15 * * * *" -> every 15 minutes (smoke test only)
#   "0 0 * * 0"    -> Sundays at midnight
SYNC_SCHEDULE_CRON=0 3 * * *

# Comma-separated list of lottery categories to schedule. Default: all 6.
SYNC_CATEGORIES=take5,lotto,powerball,megamillions,numbers,win4

# Date mode for each tick: "yesterday" (default, recommended for Socrata's
# 2-12h publication lag), "today", or "both".
SYNC_SCHEDULE_DATE_MODE=yesterday

# Optional IANA timezone (e.g. America/New_York). Defaults to server local.
# Required if your Railway container's default timezone (UTC) is not the
# timezone in which you want the daily 03:00 run to happen.
# SYNC_SCHEDULE_TZ=
