# Database configuration
DATABASE_URL=

# Server configuration
PORT=5000
BASE_URL=http://localhost:3000

# Automated Sync Secret for /api/sync/trigger
SYNC_SECRET=

# Admin session cookie HMAC secret (min 32 chars; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_SESSION_SECRET=

# Comma-separated list of allowed frontend origins for CORS with credentials
ADMIN_FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
